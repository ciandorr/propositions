%<doc>%% Internal variables
%<doc>%% ====================================================================

%<doc>%% --- Nesting level ---
\int_new:N  \g__props_level_int

%<doc>%% --- Per-item state (set during \pitem / \ptag processing) ---
%<doc>%% These are cleared at the start of \__props_resolve_item:n and then
