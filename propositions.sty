        \IfValueTF { ##1 }
          {
            %% If the argument has no =, treat it as a bare name
            %% so catcodes (e.g. $math$) are preserved.
            \tl_if_in:nnTF { ##1 } { = }
              { \pitem [ type=#2, ##1 ] }
              { \pitem [ type=#2, name={##1} ] }
          }
          { \pitem [ type=#2 ] }
      }
  }


